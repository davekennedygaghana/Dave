{
  "name": "orthoboard-reference-lab",
  "version": "1.0.0",
  "private": true,
  "description": "OrthoBoard — Reference Lab: latihan ujian board ortopedi berbasis referensi",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c teal,yellow \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p server/tsconfig.json",
    "build:client": "tsc -p client/tsconfig.json --noEmit && vite build --config client/vite.config.ts",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "seed:demo": "tsx --env-file-if-exists=.env server/src/scripts/seed-demo.ts",
    "set-password": "tsx --env-file-if-exists=.env server/src/scripts/set-password.ts",
    "test": "tsx --test server/test/*.test.ts",
    "test:e2e": "node e2e/smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.2.0",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "pdfjs-dist": "^6.5.438",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
