# Salin menjadi .env lalu isi. JANGAN commit berkas .env.

# Port server HTTP
PORT=3000

# Folder data persisten (database SQLite + berkas referensi). Pada hosting, arahkan ke volume persisten.
DATA_DIR=./data

# Zona waktu pergantian paket harian (WITA)
APP_TIMEZONE=Asia/Makassar

# Target soal per hari
DAILY_TARGET=1000

# Akun admin awal. Dibuat HANYA jika belum ada pengguna sama sekali.
# Ganti sandi setelahnya dengan: npm run set-password -- <username> <sandi-baru>
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Set "true" bila situs dilayani lewat HTTPS (cookie Secure) — wajib pada produksi.
COOKIE_SECURE=false

# Siapa yang boleh membuka berkas PDF referensi: "admin" atau "authenticated"
REFERENCE_ACCESS=admin

# Batas ukuran unggahan (MB)
MAX_UPLOAD_MB=300

# --- Integrasi AI (opsional; hanya untuk menyusun DRAFT soal di panel admin) ---
# Kosongkan untuk mematikan. Kunci hanya dibaca backend, tidak pernah dikirim ke browser.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Jumlah halaman PDF per permintaan ke model
AI_PAGES_PER_BATCH=6
